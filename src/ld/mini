    .text : {
        *(.text.startup)
        *(.text.a)
        *(.text.b)
        *(.text.c)
        *(.text.d)
        *(.text.e)
        *(.text)
    }

    .rodata : {
        *(.rodata*)
    }

    .data : {
        *(.data*)
    }

    .bss : {
        *(.bss*)
        *(COMMON)
    }
}
